        <mxCell id="note_res" value="La résistance de tirage 4,7 kΩ est IMPÉRATIVE : sans elle, le bus 1-Wire ne fonctionne pas." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="470" y="335" width="330" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tbl" value="FIL              COULEUR   BROCHE ESP32   RÔLE&#10;3,3 V           Rouge     3V3           Alimentation du capteur&#10;GND             Noir      GND           Référence de tension&#10;DATA            Jaune     GPIO16        Bus 1-Wire (données + retour)&#10;Pull-up         —         3V3 → GPIO16  Résistance 4,7 kΩ obligatoire" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="830" height="100" as="geometry" />
        </mxCell>
        <mxCell id="enc" value="ENCADREMENT" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="120" y="525" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="enc_txt" value="• 1 à 2 capteurs DS18B20 en parallèle sur le même bus 1-Wire (GPIO16 + 4,7 kΩ).&#10;• Les capteurs sont distingués par leur adresse ROM unique de 64 bits (code de famille 0x28).&#10;• Longueur de câblage recommandée : &lt; 5 m ; le DATA doit être câblé avec un fil de retour (blindé).&#10;• Broche GPIO16 libre sur la carte (cf. Specification ESP32-S3-ETH.md §4.3) — ne pas utiliser GPIO0 (bouton BOOT)." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3864;" vertex="1" parent="1">
          <mxGeometry x="120" y="550" width="830" height="80" as="geometry" />
        </mxCell>

      </root>

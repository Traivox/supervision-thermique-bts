        <mxCell id="note_res" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#1F3864;" value="La résistance de tirage 4,7 kΩ est IMPÉRATIVE : sans elle, le bus 1-Wire ne fonctionne pas." vertex="1">

        </mxCell>
        <mxCell id="tbl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;dashed=1;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;fontFamily=Courier New;" value="FIL              COULEUR   BROCHE ESP32   RÔLE&#xa;3,3 V           Rouge     3V3           Alimentation du capteur&#xa;GND             Noir      GND           Référence de tension&#xa;DATA            Jaune     GPIO16        Bus 1-Wire (données + retour)&#xa;Pull-up         —         3V3 → GPIO16  Résistance 4,7 kΩ obligatoire" vertex="1">
